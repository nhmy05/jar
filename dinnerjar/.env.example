# Leave empty to store jars in .data/jars.json while developing.
# For cloud storage (e.g. a free Neon Postgres database), paste its connection string, then run `npm run db:push`.
DATABASE_URL=

# Sign in with Google (step A of the login plan). Leave empty to hide the Sign in button.
# AUTH_SECRET: any long random text (e.g. run `npx auth secret`). Google id and secret: see PLAN-LOGIN.md.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
